---
// Ilustraciones planas dibujadas en código con la paleta de la campaña.
// Todas comparten el mismo lenguaje: formas simples, la moneda como motivo.
interface Props { name: string; class?: string; bg?: string; label?: string }
const { name, class: cls = '', bg = '#3DDC97', label } = Astro.props;
const V = '#0E6B4F', M = '#3DDC97', M2 = '#B8F5D8', A = '#FFC93C', A2 = '#E0A800', N = '#13213C', H = '#F7F5EF';
---
<svg class={cls} viewBox="0 0 400 400" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <circle cx="200" cy="200" r="200" fill={bg} />
  {name === 'presupuesto' && (
    <g>
      <rect x="92" y="96" width="216" height="232" rx="18" fill={H} />
      <rect x="92" y="96" width="216" height="56" rx="18" fill={N} />
      <rect x="92" y="130" width="216" height="22" fill={N} />
      <circle cx="128" cy="124" r="12" fill={A} />
      <rect x="152" y="117" width="96" height="14" rx="7" fill={M2} />
      <rect x="120" y="180" width="80" height="120" rx="8" fill={M} />
      <rect x="208" y="228" width="48" height="72" rx="8" fill={A} />
      <rect x="264" y="252" width="24" height="48" rx="8" fill={V} />
      <rect x="120" y="170" width="168" height="4" rx="2" fill={M2} />
    </g>
  )}
  {name === 'ahorro' && (
    <g>
      <rect x="120" y="150" width="160" height="190" rx="36" fill={H} />
      <rect x="140" y="130" width="120" height="30" rx="10" fill={N} />
      <circle cx="200" cy="300" r="26" fill={A} /><circle cx="200" cy="300" r="18" fill="none" stroke={A2} stroke-width="4" />
      <circle cx="166" cy="276" r="22" fill={A} /><circle cx="236" cy="272" r="22" fill={A} />
      <circle cx="200" cy="246" r="22" fill={A} /><circle cx="200" cy="246" r="14" fill="none" stroke={A2} stroke-width="4" />
      <path d="M200 128 V82" stroke={V} stroke-width="8" stroke-linecap="round" />
      <path d="M200 96 C182 96 164 88 160 66 C182 64 198 76 200 96 Z" fill={V} />
      <path d="M200 88 C216 86 234 76 238 54 C214 52 200 66 200 88 Z" fill={M2} />
    </g>
  )}
  {name === 'credito' && (
    <g>
      <rect x="70" y="126" width="230" height="148" rx="20" fill={N} transform="rotate(-10 185 200)" />
      <rect x="100" y="146" width="230" height="148" rx="20" fill={H} />
      <rect x="100" y="176" width="230" height="30" fill={V} />
      <rect x="124" y="232" width="52" height="38" rx="8" fill={A} />
      <rect x="194" y="246" width="110" height="12" rx="6" fill={M2} />
      <circle cx="300" cy="120" r="54" fill={A} />
      <circle cx="282" cy="104" r="10" fill={N} /><circle cx="318" cy="136" r="10" fill={N} />
      <path d="M322 96 L278 144" stroke={N} stroke-width="9" stroke-linecap="round" />
    </g>
  )}
  {name === 'estafas' && (
    <g>
      <rect x="132" y="70" width="136" height="260" rx="26" fill={N} />
      <rect x="146" y="96" width="108" height="200" rx="10" fill={H} />
      <circle cx="200" cy="164" r="44" fill={A} />
      <rect x="194" y="136" width="12" height="36" rx="6" fill={N} />
      <circle cx="200" cy="186" r="7" fill={N} />
      <rect x="162" y="232" width="76" height="12" rx="6" fill={M2} />
      <rect x="172" y="254" width="56" height="12" rx="6" fill={M2} />
      <circle cx="306" cy="292" r="40" fill={H} />
      <path d="M288 274 L324 310 M324 274 L288 310" stroke="#C0392B" stroke-width="10" stroke-linecap="round" />
    </g>
  )}
  {name === 'compras' && (
    <g>
      <path d="M110 160 H290 L272 330 H128 Z" fill={H} />
      <path d="M156 160 V132 a44 44 0 0 1 88 0 V160" fill="none" stroke={N} stroke-width="14" stroke-linecap="round" />
      <rect x="140" y="200" width="120" height="14" rx="7" fill={M2} />
      <circle cx="292" cy="112" r="62" fill={A} />
      <circle cx="292" cy="112" r="48" fill={H} />
      <path d="M292 82 V112 L312 126" stroke={N} stroke-width="9" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <text x="200" y="290" text-anchor="middle" font-family="Poppins" font-weight="800" font-size="56" fill={V}>48 h</text>
    </g>
  )}
  {name === 'registro' && (
    <g>
      <rect x="96" y="90" width="170" height="230" rx="14" fill={H} />
      <rect x="96" y="90" width="26" height="230" fill={V} />
      {[136, 172, 208, 244].map((y) => <rect x="142" y={y} width="100" height="12" rx="6" fill={M2} />)}
      <circle cx="292" cy="268" r="58" fill={A} />
      <path d="M266 270 L286 290 L322 250" stroke={N} stroke-width="11" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}
  {name === 'meta' && (
    <g>
      <circle cx="200" cy="210" r="120" fill={H} />
      <circle cx="200" cy="210" r="84" fill={M} />
      <circle cx="200" cy="210" r="48" fill={H} />
      <circle cx="200" cy="210" r="18" fill={A} />
      <path d="M200 210 L310 100" stroke={N} stroke-width="10" stroke-linecap="round" />
      <path d="M296 86 L330 80 L324 114 Z" fill={N} />
    </g>
  )}
</svg>
