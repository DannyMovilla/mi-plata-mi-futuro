---
interface Props { title: string; lead?: string; color?: string; coin?: string }
const { title, lead, color = 'var(--verde)', coin = '#FFC93C' } = Astro.props;
---
<section class="ph" style={`--bg:${color}`}>
  <div class="ph__coin" aria-hidden="true">
    <svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="100" fill={coin} /><circle cx="100" cy="100" r="80" fill="none" stroke="rgba(0,0,0,.12)" stroke-width="6" /></svg>
  </div>
  <div class="wrap ph__in">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
<style>
  .ph { position: relative; overflow: hidden; background: var(--bg); color: var(--hueso); min-height: 64svh; display: flex; align-items: flex-end; }
  .ph__coin { position: absolute; width: 86vh; height: 86vh; min-width: 520px; min-height: 520px; right: -26vh; top: 10vh; animation: drift 24s var(--ease-in-out) infinite alternate; }
  .ph__coin svg { width: 100%; height: 100%; }
  @keyframes drift { from { transform: translate(0, 0); } to { transform: translate(-3vh, 3vh); } }
  .ph__in { position: relative; z-index: 2; padding-top: 150px; padding-bottom: 72px; }
  .ph h1 { font-size: clamp(48px, 6.4vw, 104px); max-width: min(12ch, 60vw); }
  .ph .lead { max-width: min(40ch, 56vw); }
  .ph .lead { margin-top: 24px; }
  html.js .ph h1, html.js .ph .lead { animation: rise 900ms var(--ease-out) both; }
  html.js .ph .lead { animation-delay: 120ms; }
  @keyframes rise { from { opacity: 0; transform: translateY(28px); } }
  @media (max-width: 760px) {
    .ph { min-height: 70svh; }
    .ph__coin { width: 64vw; height: 64vw; min-width: 0; min-height: 0; right: -16vw; top: auto; bottom: -26vw; }
    .ph h1 { font-size: 10.5vw; max-width: none; }
    .ph .lead { max-width: 30ch; }
    .ph .lead { font-size: 17px; }
    .ph__in { padding-top: 120px; padding-bottom: 44vw; }
  }
</style>
